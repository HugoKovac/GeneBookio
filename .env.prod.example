# Starting point for the "prod" Dokploy environment's variables.
# Paste into Dokploy → this project → prod environment → Environment
# Variables, then fill in the blanks. See .env.example for what each key does.
#
# Using the same Tailscale hostname as dev "for now" (see .env.dev.example) —
# swap APP_DOMAIN for a real public domain and set CERT_RESOLVER=letsencrypt
# once one is bought/pointed at this server; nothing else needs to change.

STACK_NAME=books-prod
APP_DOMAIN=hugo-gemini-j34.taile50a8b.ts.net
# Prod keeps Dokploy's default HTTPS entrypoint/port (:443); dev uses a
# separate one (see .env.dev.example) so the two don't collide on this host.
TRAEFIK_ENTRYPOINT=websecure
# Blank until APP_DOMAIN is a publicly-reachable real domain (see note above)
# — Let's Encrypt cannot validate a .ts.net name.
CERT_RESOLVER=
ADMIN_BASIC_AUTH=admin:$$2y$$05$$replace-with-your-own-htpasswd-hash

MYSQL_USER=hkorpo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=book

RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

SEAWEED_ACCESS_KEY=
SEAWEED_SECRET_KEY=

JWT_TOKEN_EXP=60m
JWT_REFRESH_TOKEN_EXP=720h

GOOGLE_API_BOOKS=

OPENAI_API_KEY=
# Real pipeline runs — spends real OpenAI credit.
AI_TEST_MODE=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SUBSCRIPTION_SUCCESS_URL=https://hugo-gemini-j34.taile50a8b.ts.net/subscribe/return?session_id={CHECKOUT_SESSION_ID}
SUBSCRIPTION_CANCEL_URL=https://hugo-gemini-j34.taile50a8b.ts.net/subscribe
SUBSCRIPTION_PORTAL_RETURN_URL=https://hugo-gemini-j34.taile50a8b.ts.net/dashboard

REVENUECAT_WEBHOOK_AUTH_HEADER=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_ENTITLEMENT_ID=
