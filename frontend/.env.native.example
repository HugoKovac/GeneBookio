# Used for native (Capacitor) builds — copy to .env.native and adjust.
# The native app has no Vite dev proxy, so this must be an absolute URL
# reachable from the device/simulator (e.g. your machine's LAN IP while
# cmd/api runs locally, or a deployed backend URL).
VITE_API_URL=http://192.168.1.182:3000

# RevenueCat public SDK keys (Dashboard → Project → API Keys) — per-platform,
# safe to embed client-side (unlike the backend's REVENUECAT_SECRET_API_KEY).
# Required for native in-app purchases (App Store/Play Store policy requires
# these for digital subscriptions bought inside the native app — the web
# build keeps using Stripe and doesn't need these).
VITE_REVENUECAT_IOS_API_KEY=""
VITE_REVENUECAT_ANDROID_API_KEY=""

