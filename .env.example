# Env vars for the ROOT docker-compose.yaml (the Dokploy deployment stack).
# This is separate from backend/.env and backend/cmd/*/.env (those are only
# used by backend/docker-compose.yaml, the local dev orchestration).
#
# In Dokploy, paste these as "Environment Variables" on the Compose
# application — once per environment (dev/prod), with different values.
# See .env.dev.example and .env.prod.example for two ready-made starting
# points, and DOKPLOY.md for the one-time setup steps.

# ---- Traefik / domain routing ----------------------------------------------
# Unique per Dokploy environment (dev/prod) — prefixes every Traefik router,
# service and middleware name so the two environments don't collide on the
# one shared Traefik instance.
STACK_NAME=books-prod
# Public hostname both the app (/) and the admin backoffice (/admin) are
# served from.
APP_DOMAIN=example.com
# Traefik entrypoint to bind this environment's routers to. Dokploy's default
# HTTPS entrypoint is "websecure" (:443). If dev and prod share one host and
# one APP_DOMAIN (no separate DNS names), give dev a distinct entrypoint
# bound to another port — see DOKPLOY.md for the extra manual step this
# requires in Dokploy's Traefik config.
TRAEFIK_ENTRYPOINT=websecure
# Traefik certResolver name (Dokploy's default is usually "letsencrypt").
# Let's Encrypt needs the domain to be *publicly* reachable on port 80/443 to
# validate ownership — leave this BLANK for domains it can't reach (a
# Tailscale .ts.net name, a traefik.me/127.0.0.1 name, plain IP, etc.);
# Traefik then falls back to serving its own self-signed certificate.
CERT_RESOLVER=letsencrypt
# htpasswd-format "user:hash" pair(s) protecting /admin (frontend-admin has no
# auth of its own — see CLAUDE.md). Generate with:
#   htpasswd -nB admin
# (escape every literal "$" as "$$" if you paste the hash directly into a
# docker-compose environment/label value)
ADMIN_BASIC_AUTH=admin:$$2y$$05$$replace-with-your-own-htpasswd-hash

# ---- MySQL ------------------------------------------------------------------
MYSQL_USER=hkorpo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=book

# ---- RabbitMQ ----------------------------------------------------------------
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# ---- SeaweedFS (S3-compatible object storage) --------------------------------
SEAWEED_ACCESS_KEY=
SEAWEED_SECRET_KEY=

# ---- Auth (cmd/api, cmd/admin) -----------------------------------------------
JWT_TOKEN_EXP=60m
JWT_REFRESH_TOKEN_EXP=720h

# ---- Google Books (cmd/api, cmd/admin) ---------------------------------------
GOOGLE_API_BOOKS=

# ---- OpenAI (prepare_chapters, generate_script, generate_tts) ---------------
OPENAI_API_KEY=
# true = use the free substitution client instead of calling OpenAI for real.
AI_TEST_MODE=true

# ---- Stripe (cmd/api) --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SUBSCRIPTION_SUCCESS_URL=https://example.com/subscribe/return?session_id={CHECKOUT_SESSION_ID}
SUBSCRIPTION_CANCEL_URL=https://example.com/subscribe
SUBSCRIPTION_PORTAL_RETURN_URL=https://example.com/dashboard

# ---- RevenueCat (cmd/api) -----------------------------------------------------
REVENUECAT_WEBHOOK_AUTH_HEADER=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_ENTITLEMENT_ID=
