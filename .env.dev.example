# Starting point for the "dev" Dokploy environment's variables.
# Paste into Dokploy → this project → dev environment → Environment Variables,
# then fill in the blanks. See .env.example for what each key does.

STACK_NAME=books-dev
# Tailscale MagicDNS name — only reachable from your tailnet, and it has no
# wildcard subdomains, which is why app (/) and admin (/admin) are split by
# PATH here rather than by subdomain, and dev/prod share this same hostname
# split by PORT instead (see TRAEFIK_ENTRYPOINT below and DOKPLOY.md).
APP_DOMAIN=hugo-gemini-j34.taile50a8b.ts.net
# Dedicated entrypoint/port for dev so it doesn't collide with prod on the
# same hostname (e.g. bound to :8443) — requires the one-time Traefik static
# config change described in DOKPLOY.md.
TRAEFIK_ENTRYPOINT=websecure-dev
# Let's Encrypt can't validate a .ts.net (or traefik.me/127.0.0.1) name over
# the public internet, so leave this blank — Traefik will serve its own
# self-signed certificate instead (expect a browser warning, that's fine on
# a private tailnet).
CERT_RESOLVER=
ADMIN_BASIC_AUTH=admin:$$2y$$05$$replace-with-your-own-htpasswd-hash

MYSQL_USER=hkorpo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=book

RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

SEAWEED_ACCESS_KEY=
SEAWEED_SECRET_KEY=

JWT_TOKEN_EXP=60m
JWT_REFRESH_TOKEN_EXP=720h

GOOGLE_API_BOOKS=

OPENAI_API_KEY=
AI_TEST_MODE=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
SUBSCRIPTION_SUCCESS_URL=https://hugo-gemini-j34.taile50a8b.ts.net:8443/subscribe/return?session_id={CHECKOUT_SESSION_ID}
SUBSCRIPTION_CANCEL_URL=https://hugo-gemini-j34.taile50a8b.ts.net:8443/subscribe
SUBSCRIPTION_PORTAL_RETURN_URL=https://hugo-gemini-j34.taile50a8b.ts.net:8443/dashboard

REVENUECAT_WEBHOOK_AUTH_HEADER=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_ENTITLEMENT_ID=
