ENV_STATE="loaded"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""
MYSQL_DATABASE=""
MYSQL_HOST="localhost:3366"
PUBLIC_KEY_PATH="keys/JWT_public.pem"
PRIVATE_KEY_PATH="keys/JWT_private.pem"
PUBLIC_REFRESH_KEY_PATH="keys/JWT_REFRESH_public.pem"
PRIVATE_REFRESH_KEY_PATH="keys/JWT_REFRESH_private.pem"
JWT_TOKEN_EXP="60m"
JWT_REFRESH_TOKEN_EXP="720h"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_ENPOINT=""
MINIO_USE_SSL=false
GOOGLE_API_BOOKS=""
# Test mode ("sandbox") vs live is just which key you paste here — Stripe test
# secret keys start with sk_test_, live ones with sk_live_.
STRIPE_SECRET_KEY=""
# From the Stripe Dashboard's Webhooks tab once the endpoint is registered
# (https://dashboard.stripe.com/webhooks) — or `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=""
# ID of the recurring Price created once in the Stripe Dashboard (Product
# catalog) for the flat subscription plan, e.g. price_1AbCdE...
STRIPE_PRICE_ID=""
SUBSCRIPTION_SUCCESS_URL="http://localhost:5173/subscribe/return?session_id={CHECKOUT_SESSION_ID}"
SUBSCRIPTION_CANCEL_URL="http://localhost:5173/subscribe"
SUBSCRIPTION_PORTAL_RETURN_URL="http://localhost:5173/dashboard"
# RevenueCat dashboard -> Project -> Integrations -> Webhooks -> Authorization
# Header Value -- a shared secret RevenueCat echoes back on every webhook
# request, compared constant-time. Server secret, distinct from the public
# SDK keys the native apps embed (see frontend/.env.native.example).
REVENUECAT_WEBHOOK_AUTH_HEADER=""
# RevenueCat Secret API key (v2) -- Project Settings -> API Keys. Used only
# for the server-to-RevenueCat REST reconcile call, never exposed to the
# frontend.
REVENUECAT_SECRET_API_KEY=""
REVENUECAT_PROJECT_ID=""
# The single RevenueCat Entitlement identifier both the App Store and Play
# Store products are attached to in the RevenueCat dashboard, e.g. "premium".
REVENUECAT_ENTITLEMENT_ID=""