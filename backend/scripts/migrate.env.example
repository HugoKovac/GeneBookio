# Copy to migrate.env and fill in, then: source migrate.env
#
# Used by migrate_mysql.sh, migrate_minio.sh and migrate_all.sh.
# SRC_* points at the host you're leaving, DST_* at the new host.

# --- MySQL source (current host) ---
SRC_MYSQL_HOST="localhost"
SRC_MYSQL_PORT="3366"
SRC_MYSQL_USER="root"
SRC_MYSQL_PASSWORD=""
SRC_MYSQL_DATABASE="book"

# --- MySQL destination (new host) ---
DST_MYSQL_HOST="new-host.example.com"
DST_MYSQL_PORT="3306"
DST_MYSQL_USER="root"
DST_MYSQL_PASSWORD=""
DST_MYSQL_DATABASE="book"

# --- S3-compatible source (current host) ---
# Despite the MINIO_* name (migrate_minio.sh is named after the `mc` CLI it
# uses, not the target), this project's object store is SeaweedFS's S3
# gateway — see cmd/*/.env's MINIO_ENPOINT/ACCESS_KEY/SECRET_KEY. Defaults
# below match backend/.env's `seaweed` service (port 8333).
SRC_MINIO_ENDPOINT="localhost:8333"
SRC_MINIO_ACCESS_KEY="seaweedadmin"
SRC_MINIO_SECRET_KEY=""
SRC_MINIO_USE_SSL="false"

# --- S3-compatible destination (new host) ---
# Works with any S3-compatible target: another SeaweedFS, MinIO, AWS S3,
# DigitalOcean Spaces, Backblaze B2, etc. — just point endpoint/keys at it.
DST_MINIO_ENDPOINT="new-host.example.com:8333"
DST_MINIO_ACCESS_KEY=""
DST_MINIO_SECRET_KEY=""
DST_MINIO_USE_SSL="true"
